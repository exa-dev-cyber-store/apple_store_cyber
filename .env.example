# ==============================================================================
# Cyber Apple Store - Web Frontend (.env.example)
# Duplicate this file as '.env' and populate with your actual environment values.
# DO NOT commit the actual '.env' file to version control.
# ==============================================================================

# Application & Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API Endpoints (BFF Proxy & Direct Backend URL)
API_ENDPOINT_DATA=http://localhost:5000/api
API_ENDPOINT_USER=http://localhost:5000/auth
NEXT_PUBLIC_API_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_IMAGE_URL=http://localhost:5000/images

# MinIO / S3 CDN Storage Base URL
NEXT_PUBLIC_API_URL=https://storage.yourdomain.com

# Google OAuth 2.0 (Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Sign in with Apple (Web Services)
APPLE_ID=cloud.yourdomain.apple-store.service
NEXT_PUBLIC_APPLE_CLIENT_ID=cloud.yourdomain.apple-store.service
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://yourdomain.com/api/auth/callback/apple

# Midtrans Payment Gateway (Snap / Core API)
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_OVERRIDE_NOTIFICATION_URL=https://yourdomain.com/api/orders/notification

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# Firebase Cloud Messaging (FCM Web Push)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_vapid_key
